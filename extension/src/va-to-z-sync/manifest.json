{
  "manifest_version": 3,
  "name": "VA to Z Sync",
  "version": "1.1.0",
  "description": "Reads your own info from VA.gov (while you are logged in) and sends it to the VA to Z app. Read-only. Never touches your password.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VA to Z Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.va.gov/*",
    "https://api.va.gov/*",
    "https://rrkennedy69.github.io/VA-to-Z/*",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://rrkennedy69.github.io/VA-to-Z/*",
        "file:///*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://rrkennedy69.github.io/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  }
}