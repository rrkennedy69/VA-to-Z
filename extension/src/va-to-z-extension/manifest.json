{
  "manifest_version": 3,
  "name": "VA to Z",
  "version": "1.0.19",
  "description": "VA disability claim helper with built-in VA.gov sync. Your data stays on this computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VA to Z",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "app.html?popup=1"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "identity"
  ],
  "key": "",
  "oauth2": {
    "client_id": "403035756867-b7phk8k7u97658csmcmudm32hbnrjfbk.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata",
      "openid",
      "email"
    ]
  },
  "host_permissions": [
    "https://www.va.gov/*",
    "https://api.va.gov/*",
    "https://api.x.ai/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ]
}